LLM_PROVIDER=mock
# Groq Setup (Supports multiple comma-separated keys for round-robin to bypass rate limits)
# GROQ_API_KEYS=gsk_abc123,gsk_def456
GROQ_MODEL_PLANNER=llama-3.1-8b-instant
GROQ_MODEL_CONTEXT=llama-3.1-8b-instant
GROQ_MODEL_CODER=llama-3.3-70b-versatile
GROQ_MODEL_REVIEWER=llama-3.1-8b-instant

# OpenAI Setup
# OPENAI_API_KEY=sk-proj-...
# OPENAI_MODEL=gpt-4o-mini

# Ollama Setup (Local models)
